# Anthropic Admin API credentials.
# Create an admin key at https://console.anthropic.com/settings/admin-keys
ANTHROPIC_ADMIN_API_KEY=sk-ant-admin01-...
ANTHROPIC_ORG_ID=

# Local cache DB path (SQLite)
BENCHY_CACHE_DB=./benchy.sqlite

# Backend bind
BENCHY_HOST=127.0.0.1
BENCHY_PORT=8000

# Frontend dev origin (for CORS)
BENCHY_FRONTEND_ORIGIN=http://127.0.0.1:5173
